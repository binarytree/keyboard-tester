{
  "name": "keyboard-tester",
  "version": "1.0.0",
  "description": "Pure TypeScript core for browser keyboard testers: ANSI/ISO/ChromeOS layouts, key state machine, reports. Privacy-auditable, no network.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "keyboard",
    "keyboard-test",
    "keyboard-tester",
    "chromebook",
    "chromeos",
    "nkro",
    "key-rollover",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
